{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planning-poker-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "ROOMS_BUCKET",
      // Create with: wrangler r2 bucket create planning-poker-rooms
      "bucket_name": "planning-poker-rooms"
    }
  ],
  "routes": [
    {
      "pattern": "tamdoan.work/product/planning-poker*",
      "zone_name": "tamdoan.work"
    }
  ]
}
